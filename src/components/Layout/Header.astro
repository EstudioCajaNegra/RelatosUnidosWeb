---
import SocialMedia from "../common/SocialMedia.astro";
import Menu from "./Menu.astro";
import { Image } from "astro:assets";
import iconoRelatosUnidos from "../../assets/icon_RU.svg";
---

<header
    class="flex justify-center w-full"
>
    <div class="flex justify-between items-center max-w-desktop p-3 w-full">
        <div class="flex items-center space-x-3">
            <Image
                src={iconoRelatosUnidos}
                alt="Icono Relatos Unidos"
                width="40"
                height="40"
            />
            <span class="p-1.75 border font-bigshoulders font-medium"
                >Trueque de Relatos</span
            >
        </div>
        <nav class="flex items-center space-x-3">
            <SocialMedia class="hidden sm:flex" />
            <Menu />
        </nav>
    </div>
</header>
