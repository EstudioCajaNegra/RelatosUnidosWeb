---
const pages = import.meta.glob('../../pages/**/*.astro', { eager: true });

const { pathname } = Astro.url;
const currentPath = pathname.replace(/\/$/, '');

const menuItems = Object.entries(pages)
  .map(([file, module]: [string, any]) => {
    const route = file
      .replace(/^([\.\/]+)pages/, '')
      .replace(/\/index\.astro$/, '')
      .replace(/\.astro$/, '');

    return {
      route: route === '' ? '/' : route,
      label: module.title || 'Sin título',
      order: module.order ?? 999,
    };
  })
  .sort((a, b) => a.order - b.order);
---

<div id="main-menu" class="nav-links">
  {menuItems.map((item) => (
    <a
      href={item.route}
      class={item.route === currentPath ? 'active' : ''}
    >
      {item.label}
    </a>
  ))}
</div>